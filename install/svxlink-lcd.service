
[Unit]
Description=SvxLink LCD Control and Monitoring
After=network.target svxlink-dash.service
Wants=svxlink-dash.service

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=i2c
WorkingDirectory=/opt/svxlink-lcd
ExecStart=/opt/svxlink-lcd/venv/bin/python /opt/svxlink-lcd/lcd_controller.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
